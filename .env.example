# ---------------------------------------------------------------------------
# DevMatrix environment variables
#
# Copy this file to the appropriate location and fill in real values:
#   - apps/api/.env   (server / secrets — never commit)
#   - apps/web/.env.local (public vars only)
# `.env` files are git-ignored; this example file is not.
# ---------------------------------------------------------------------------

# ----------------------------- API (apps/api/.env) --------------------------

# Runtime
NODE_ENV=development
PORT=3001

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/devmatrix

# JWT secrets — REQUIRED. Use long, random values (e.g. `openssl rand -hex 32`).
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Public URL of the web app. Used for OAuth redirects and as a CORS fallback.
FRONTEND_URL=http://localhost:3000

# Comma-separated allow-list of origins permitted to make credentialed
# requests. Falls back to FRONTEND_URL, then localhost:3000 in development.
# Never allows a wildcard in production.
CORS_ORIGINS=http://localhost:3000

# Cookies. SameSite=None requires Secure (HTTPS). Set COOKIE_DOMAIN only when
# the API and web app share a parent domain (e.g. `.example.com`).
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# GitHub OAuth app credentials (Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Groq API keys for the AI services
AI_DEBUG_GROQ_API_KEY=
IDEA_VALIDATOR_GROQ_API_KEY=

# Set to any value to enable verbose debug logging
# DEBUG=

# ------------------------- Web (apps/web/.env.local) ------------------------

# Base URL of the API. Defaults to http://localhost:3001/api in development
# and https://api.devmatrix.mahdyardev.ir/api in production.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
